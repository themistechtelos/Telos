# Copie este arquivo para .env. A OpenAI é o provedor padrão; escolha uma chave.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Computador: envio pelo Gmail. Na hospedagem, GMAIL_SENDER é o remetente autorizado na conta Brevo.
GMAIL_SENDER=
# Usada somente no computador; deixe vazia se não for enviar pelo Gmail.
GMAIL_APP_PASSWORD=
# Necessária só na hospedagem; o remetente acima precisa estar autorizado na conta Brevo.
BREVO_API_KEY=
# Usado no computador: aceita endereços separados por vírgula, em cópia oculta.
# A hospedagem ignora este campo e envia só ao endereço digitado na página.
GMAIL_RECIPIENT=
TJSP_SEARCH_TERMS=juros contrato empréstimo bancário;cartão de crédito dívida negativação pagamento;garantia contrato financiamento bancário;atraso entrega apartamento na planta prazo tolerância 180 dias aluguel multa construtora;INCC saldo devedor atraso obra imóvel na planta construtora;desistência compra imóvel na planta retenção valores pagos construtora;vícios construtivos infiltração rachaduras apartamento novo reparos construtora;cobrança taxas condominiais condomínio inadimplente execução;despejo falta pagamento aluguel locação residencial quatro meses;ação renovatória locação comercial revisão aluguel loja;duplicata protestada serviço não prestado cancelamento protesto indenização;cobrança notas fiscais mercadorias fornecidas inadimplência empresa;rescisão contrato franquia falta suporte multa franqueadora;dissolução parcial sociedade limitada retirada sócio apuração de haveres;habilitação crédito recuperação judicial fornecedor credor
TJSP_SEARCH_TERMS_BANCARIO=juros contrato empréstimo bancário;cartão de crédito dívida negativação pagamento;garantia contrato financiamento bancário
TJSP_SEARCH_TERMS_IMOBILIARIO=atraso entrega apartamento na planta prazo tolerância 180 dias aluguel multa construtora;INCC saldo devedor atraso obra imóvel na planta construtora;desistência compra imóvel na planta retenção valores pagos construtora;vícios construtivos infiltração rachaduras apartamento novo reparos construtora;cobrança taxas condominiais condomínio inadimplente execução;despejo falta pagamento aluguel locação residencial quatro meses;ação renovatória locação comercial revisão aluguel loja
TJSP_SEARCH_TERMS_EMPRESARIAL=duplicata protestada serviço não prestado cancelamento protesto indenização;cobrança notas fiscais mercadorias fornecidas inadimplência empresa;rescisão contrato franquia falta suporte multa franqueadora;dissolução parcial sociedade limitada retirada sócio apuração de haveres;habilitação crédito recuperação judicial fornecedor credor
# Modo seguro para apresentação: rodada fixa, sem chamadas ao TJSP nem à IA. Use false para modo ao vivo.
TELOS_DEMO_MODE=true

# Na hospedagem, force a demonstração e limite o envio: 1 e-mail por minuto e 20 por dia.
# Nesse modo, o botão envia somente ao endereço digitado na página, nunca a GMAIL_RECIPIENT.
# No computador, deixe false para manter o comportamento controlado por TELOS_DEMO_MODE.
TELOS_HOSPEDADO=false
