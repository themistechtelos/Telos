# Copie este arquivo para .env. A OpenAI é o provedor padrão; escolha uma chave.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Computador: envio pelo Gmail. Na hospedagem, GMAIL_SENDER é o remetente autorizado na conta Brevo.
GMAIL_SENDER=
# Usada somente no computador; deixe vazia se não for enviar pelo Gmail.
GMAIL_APP_PASSWORD=
# Necessária só na hospedagem; o remetente acima precisa estar autorizado na conta Brevo.
BREVO_API_KEY=
# Usado no computador: aceita endereços separados por vírgula, em cópia oculta.
# A hospedagem ignora este campo e envia só ao endereço digitado na página.
GMAIL_RECIPIENT=
# O STJ procura estes termos literalmente nas íntegras diárias. Separe vários termos com ponto e vírgula.
STJ_SEARCH_TERMS_BANCARIO=juros remuneratórios;juros abusivos;assinatura impugnada contrato bancário;autenticidade de assinatura;empréstimo consignado;dívida paga cobrança judicial;repetição em dobro;devolução em dobro cobrança indevida
STJ_SEARCH_TERMS_IMOBILIARIO=atraso na entrega de imóvel;lucros cessantes;cláusula penal moratória;INCC;saldo devedor;distrato;retenção de parcelas;compra e venda de imóvel
STJ_SEARCH_TERMS_EMPRESARIAL=recuperação judicial;fato gerador do crédito;habilitação de crédito;duplicata protestada;notas fiscais;franquia;apuração de haveres;dissolução parcial
# Modo de demonstração: rodada fixa, sem chamadas ao STJ nem à IA. Use false para busca e análise ao vivo no STJ.
TELOS_DEMO_MODE=true

# Na hospedagem, force a demonstração e limite o envio: 1 e-mail por minuto e 20 por dia.
# Nesse modo, o botão envia somente ao endereço digitado na página, nunca a GMAIL_RECIPIENT.
# No computador, deixe false para manter o comportamento controlado por TELOS_DEMO_MODE.
TELOS_HOSPEDADO=false
