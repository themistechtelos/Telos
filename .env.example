# Copie este arquivo para .env. A OpenAI é o provedor padrão; escolha uma chave.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Opcional: deixe os três campos abaixo vazios para não enviar e-mails.
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
# Aceita um ou mais endereços separados por vírgula; os destinatários ficam ocultos entre si.
GMAIL_RECIPIENT=
